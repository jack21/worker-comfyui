{
  "tests": [
    {
      "name": "comfyui_boot_test",
      "input": {
        "workflow": {
          "1": {
            "class_type": "EmptyImage",
            "inputs": {
              "width": 64,
              "height": 64,
              "batch_size": 1,
              "color": 0
            }
          },
          "2": {
            "class_type": "SaveImage",
            "inputs": {
              "images": [
                "1",
                0
              ],
              "filename_prefix": "boot_test"
            }
          }
        }
      },
      "timeout": 300000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "env": [
      {
        "key": "REFRESH_WORKER",
        "value": "false"
      }
    ],
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0"
    ]
  }
}
